<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/startupOverlay" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/home_window_bg" android:clickable="true" android:focusable="true" android:focusableInTouchMode="true">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:gravity="center" android:orientation="vertical" android:padding="32dp">
        <TextView android:id="@+id/startupGreeting" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/home_welcome" android:textColor="#FFFFFF" android:textSize="36sp" android:fontFamily="@font/outfit" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:text="@string/home_preparing" android:textColor="#EBEBF1" android:textSize="18sp" android:fontFamily="@font/outfit" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="@string/home_preparing_detail" android:textColor="#9999A5" android:textSize="13sp" android:fontFamily="@font/outfit" />
        <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="120dp" android:layout_height="3dp"
            android:layout_marginTop="28dp" android:indeterminate="true" android:indeterminateTint="#DCDCE5" />
    </LinearLayout>
</FrameLayout>
